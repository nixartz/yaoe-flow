# ─────────────────────────────────────────────────────────────────────────────
# YAOE-FLOW — example environment (dev / Docker)
#
# In the standalone binary mode you normally do NOT need this file: run
# "yaoe-flow setup" once — bootstrap keys go to ~/.yaoe-flow/config.env and
# everything else is stored encrypted in the database (editable on the
# dashboard Config screen).
#
# Precedence: real ENV > database (Config screen) > default.
# Full reference of every setting: app/src/config/registry.ts (also rendered
# on the dashboard Config screen with descriptions).
# ─────────────────────────────────────────────────────────────────────────────

# ── Bootstrap (ENV only — needed before the database opens) ──
HOST=localhost
PORT=4790
DASHBOARD_ENABLED=true
DASHBOARD_PORT=4791
# SQLite file (runs, webhooks, logs, users, settings). Default: $YAOE_HOME/data/dashboard.sqlite
#DASHBOARD_DB_PATH=./data/dashboard.sqlite
# openssl rand -hex 32  (REQUIRED — encrypts secrets at rest; the wizard generates one)
APP_ENCRYPTION_KEY=
# openssl rand -hex 32  (signs the dashboard session cookie)
DASHBOARD_SESSION_SECRET=
# Valkey/Redis — footprint locks + attempt counters
VALKEY_URL=redis://127.0.0.1:6379

# ── Service ──
ORCHESTRATOR_ENABLED=true
TICK_INTERVAL_MS=30000
LOG_LEVEL=info
# Language of the agents' human-facing output (Linear/PR comments)
AGENT_OUTPUT_LANGUAGE=English

# ── Linear (usually configured via wizard/dashboard, encrypted in the db) ──
#LINEAR_API_KEY=
#LINEAR_TEAM_ID=
#LINEAR_TEAM_KEY=
#LINEAR_WEBHOOK_SECRET=

# ── GitHub ──
#GITHUB_TOKEN=
#AGENT_AUTHORIZED_ORGS=your-org
# Process-doc globs the scope-check treats as ancillary (change bundles/OKF/CHANGELOG
# required by each repo's AGENTS.md — protocol §8.1/§14). Set it to YOUR repos' layout.
#SCOPE_ANCILLARY_DOC_PATHS=CHANGELOG.md,knowledge/changes/**,docs/changes/**,.okf/**

# ── Capacity ──
MAX_PMO_WORKERS=1
MAX_DEV_WORKERS=1
MAX_REVIEWER_WORKERS=1
MAX_ORCHESTRATOR_WORKERS=1

# ── Agent workspaces ──
# Base dir for per-run clones (run-<id>). Default: $YAOE_HOME/worktrees
#WORKSPACE_ROOT=

# ── Harness: Goose / OpenRouter (optional) ──
#OPENROUTER_API_KEY=
#GOOSE_BIN=goose
#GOOSE_MODEL=

# ── Harness: Hermes HTTP gateway (optional) ──
#HERMES_BASE_URL=http://hermes:3000
#HERMES_API_KEY=

# ── Docker-only helpers ──
# Seed of the first dashboard admin when the users table is empty:
#DASHBOARD_USER=admin
#DASHBOARD_PASSWORD=change-me
