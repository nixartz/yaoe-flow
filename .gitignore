# macOS
.DS_Store

# Dependencies
node_modules/

# Build output — binaries go to GitHub Releases, never into git
dist/
build/

# Dashboard Vite output (also listed in dashboard/.gitignore). The SPA is
# baked into the binary at release/install-local time via embed-assets — never
# commit dashboard/dist or a non-empty EMBEDDED_DASHBOARD_ASSETS blob.
dashboard/dist/
dashboard/dist-ssr/

# Local runtime state (daemon home lives in ~/.yaoe-flow, but keep repo-local
# fallbacks ignored too)
.data/
data/
run-*-home/
worktrees/

# Environment / secrets — only .env.example is committed
.env
.env.*
!.env.example
.myenv
*.bak

# Logs
*.log
/logs

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Personal scratch notes
.notes.md
